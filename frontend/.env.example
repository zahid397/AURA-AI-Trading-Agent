# Copy to .env.local to override. See src/services/api.ts for the fixture/live seam.
# 'fixture' (default in .env.development) resolves all requests from src/dev/fixtures
# with a simulated network delay -- no backend required.
# 'live' sends real Axios requests to VITE_API_BASE_URL.
VITE_API_MODE=fixture
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_FIXTURE_DELAY_MS=350
