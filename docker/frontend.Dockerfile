FROM node:22-alpine AS build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
# `npm ci` fails here with EBADPLATFORM on esbuild's per-platform optional
# binaries (@esbuild/aix-ppc64 etc.) -- a known npm bug where its stricter
# lockfile-verification mode mishandles optionalDependencies platform
# filtering when the lockfile was generated by a different npm version/OS
# (this one: npm 11 on Windows) than the installing npm (bundled with this
# Alpine image). `npm install` still honors package-lock.json's pinned
# versions but resolves optional platform packages correctly instead of
# hard-failing on the ones that don't apply.
RUN npm install
COPY frontend/ ./
# Nginx (below) reverse-proxies /api on the SAME origin the browser loads the
# SPA from, so the built app must call a relative path -- overriding the
# checked-in .env.production (which points at localhost:8000 for the
# `npm run build && npm run preview` local workflow instead).
ENV VITE_API_BASE_URL=/api/v1
ENV VITE_API_MODE=live
RUN npm run build

FROM nginx:1.27-alpine
COPY docker/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
# `127.0.0.1`, not `localhost`: this Alpine image's /etc/hosts resolves
# `localhost` to ::1 first, nginx's `listen 80;` is IPv4-only, and BusyBox's
# wget doesn't fall back to the working IPv4 address after an IPv6
# connection refusal -- it just fails, permanently marking the container
# unhealthy even though it's actually serving traffic fine on port 80.
HEALTHCHECK --interval=15s --timeout=5s --retries=3 \
    CMD wget -q -O- http://127.0.0.1/ >/dev/null || exit 1
