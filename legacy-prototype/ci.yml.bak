# WRITTEN AS A REFERENCE STARTING POINT -- NEVER TRIGGERED OR VERIFIED.
# There is no way to run an actual GitHub Actions workflow from this sandbox,
# so this YAML has been reviewed by eye only, not executed. The test command
# it runs (`python3 -m unittest tests.test_agents`) IS the exact command that
# was actually run locally and passed 17/17 -- see docs/IMPLEMENTATION_STATUS.md.
name: CI

on:
  push:
  pull_request:

jobs:
  backend-tests:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - name: Install dependencies
        working-directory: backend
        run: pip install -r requirements.txt
      - name: Run tests
        working-directory: backend
        run: python3 -m unittest tests.test_agents -v
