# Root-level Docker Compose configuration. Service-specific settings live in
# backend/.env and ai-engine/.env (copy each from its own .env.example) —
# this file only holds values shared across containers (Postgres creds) or
# used directly by compose.yml's variable substitution.
#
# Never commit a real .env file. This example contains no real secrets.

POSTGRES_DB=aura
POSTGRES_USER=aura
POSTGRES_PASSWORD=aura_dev_only_change_me
