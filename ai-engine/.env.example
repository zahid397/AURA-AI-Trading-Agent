# AURA AI Engine -- environment configuration
# Copy to .env for local development. Never commit a real .env file.

# Hard safety rail: must be "paper" or "demo". Anything else fails startup.
TRADING_ENV=demo
ALLOW_LIVE_TRADING=false

# Alpaca paper credentials (leave blank to force the demo adapter -- no network calls)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_BASE_URL=https://data.alpaca.markets
ALPACA_PAPER_TRADE=true

# LLM provider: "fake" (deterministic, offline, default) or "anthropic"
LLM_PROVIDER=fake
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5

# Internal Laravel <-> FastAPI signed API (must match backend/.env's AURA_INTERNAL_SIGNING_SECRET)
INTERNAL_SIGNING_SECRET=local-dev-internal-signing-secret-change-me
LARAVEL_INTERNAL_BASE_URL=http://localhost:8000/api/internal/v1
INTERNAL_TIMESTAMP_SKEW_SECONDS=300

# LangGraph durable checkpoint store
LANGGRAPH_CHECKPOINT_PATH=./aura_langgraph_checkpoints.sqlite
